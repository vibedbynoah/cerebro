# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Node / frontend
node_modules/
dist/
.vite/

# Tauri
src-tauri/target/
src-tauri/gen/

# Marrow runtime artifacts
/bench-results/
/profiles/*.local.json
*.log

# Fetched for the installer (scripts/fetch-dxc.mjs)
apps/desktop/src-tauri/resources/dxc/

# Vendored engine binaries (large, fetched not committed)
/vendor/llama.cpp/**/*.exe
/vendor/llama.cpp/**/*.dll
/vendor/llama.cpp/**/*.so

# Models never enter the repo
*.gguf
*.safetensors
*.bin

# OS
Thumbs.db
desktop.ini
.DS_Store

# Design system: compiled JS (built from .ts for the dependency-free preview server only;
# Astro/Vite and the Tauri app compile the .ts sources directly and never need these)
/design/motion.js
/design/preview.js
/design/contrast.js
/design/terms.js
/design/*.js.map

# Design system: reference screenshots of other companies' sites, for local comparison only
/design/review/refs/

# Design system: Playwright run artifacts (not build output, regenerated every `npm test`/`npm run shoot`)
/design/test-results/
/design/playwright-report/

# Design system: regenerated specimen screenshots (~5 MB per `npm run shoot`)
/design/review/shots/

# Python bytecode (tools/local review scripts)
__pycache__/

# Desktop app: desktop-mode build, Playwright artifacts and review screenshots (regenerated)
/apps/desktop/ui/dist-desktop/
/apps/desktop/test-results/
/apps/desktop/playwright-report/
/apps/desktop/review/shots/
/apps/desktop/src-tauri/gen/
