{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerebro",
  "version": "0.1.0",
  "identifier": "io.github.noahmrauch.cerebro",
  "build": {
    "frontendDist": "../ui/dist-desktop",
    "beforeDevCommand": "npm run build:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Cerebro",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'sha256-YEercZJImS+vUX2bz7vkQ0aA4rtBIPLuCEWz+yraQ/g='",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:8181",
        "media-src": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'none'",
        "frame-src": "http://*.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": { "enable": false },
      "pattern": {
        "use": "isolation",
        "options": { "dir": "../isolation" }
      },
      "capabilities": ["main-window"],
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff",
        "Permissions-Policy": "accelerometer=(), autoplay=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Measure, tune and run local language models offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
