{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Everything the main window may call, and nothing else. Local pages only (no `remote`), no core:default, no shell, no fs. Window commands act on the calling window; engine commands take validated arguments (see isolation/index.js).",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "permissions": [
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-close",
    "allow-app-info",
    "allow-hub-cancel",
    "allow-hub-download",
    "allow-hub-files",
    "allow-hub-file-meta",
    "allow-hub-search",
    "allow-metrics",
    "allow-metrics-history",
    "allow-request-detail",
    "allow-live-stats",
    "allow-chat-stop",
    "allow-chat-send",
    "allow-kv-store-usage",
    "allow-kv-store-clear",
    "allow-models-loaded",
    "allow-placement-preview",
    "allow-model-unload",
    "allow-model-load",
    "allow-library-list",
    "allow-hw-detect",
    "allow-switches-list",
    "allow-switch-set",
    "allow-switches-reset",
    "allow-tune-machine-start",
    "allow-tune-machine-last",
    "allow-mcp-config-get",
    "allow-mcp-config-save",
    "allow-mcp-status",
    "allow-mcp-restart",
    "allow-mcp-tools",
    "allow-mcp-call",
    "allow-remote-get",
    "allow-remote-set-password",
    "allow-remote-enable",
    "allow-remote-options",
    "allow-remote-pair",
    "allow-remote-revoke",
    "allow-chat-tool-decide",
    "allow-chat-tool-answer",
    "allow-builtin-tools",
    "allow-builtin-folders-get",
    "allow-builtin-folders-set",
    "allow-mcp-server-get",
    "allow-mcp-server-enable",
    "allow-mcp-server-rotate-token",
    "allow-local-api-get",
    "allow-local-api-enable",
    "allow-local-api-options",
    "allow-local-api-rotate-key",
    "allow-trainer-status",
    "allow-trainer-setup",
    "allow-trainer-start",
    "allow-trainer-cancel",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
